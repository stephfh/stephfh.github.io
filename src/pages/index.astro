<style>
    .introduction__title {
        font-family: var(--font-stack-serif), serif;
        margin-top: 3rem;
    }

    .elsewhere {
        list-style: none;
        display: flex;
        flex-flow: row wrap;
        gap: 0.5rem;
    }

    .elsewhere-item__anchor {

        height: 3rem;
        padding: 0.75rem;
    }

    .elsewhere-item__anchor svg {
        height: 1.5rem;
        width: 1.5rem;
    }

    .github {
        fill: var(--github);
    }

    .mastodon {
        fill: var(--mastodon);
    }

    .bluesky {
        fill: var(--bluesky);
    }
</style>